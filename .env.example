# 示例环境变量。真实凭据禁止提交 Git（设计文档 §11.3）。
POSTGRES_PASSWORD=change-me
KNOWLEDGE_QUERY_API_KEY=change-query-key
KNOWLEDGE_MANAGEMENT_API_KEY=change-management-key
STORAGE_ROOT_HOST=./data

# ---- Embedding（阶段四）----
# provider: openai（OpenAI 兼容，Qwen3/BGE-M3 本地或云 API）或 gemini（官方 SDK，临时验证通道）
# openai = OpenAI 兼容接口（本地 vLLM/Ollama/TEI 或云 API，如 SiliconFlow）
EMBEDDING_PROVIDER=openai
# 本地 Ollama 示例：http://localhost:11434/v1
# SiliconFlow 示例：https://api.siliconflow.cn/v1
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=v1

# --- SiliconFlow（Qwen3-Embedding，国内可用，1024 维）---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_DIMENSION=1024
# EMBEDDING_VERSION=sf-qwen3-8b-1024

# --- 显式关闭向量通道（仅关键词检索）---
# EMBEDDING_PROVIDER=none

# Gemini 临时验证通道示例（仅开发/闭环验证，勿用于真实生产数据）：
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=<your-gemini-api-key>
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=1024

# ── 无答案判断（设计文档 §5.5、§16）──────────────────────────────
# 低于阈值的候选不视为有效证据，检索返回 noEvidence=true 且 results 为空。
# 上述值由 eval/calibrate_threshold.py 在标注集上实测标定（2026-09-28，41 正 / 40 负）。
# ⚠️ 更换 Embedding 模型或语料后必须重跑标定脚本，不可沿用旧阈值。
# NO_EVIDENCE_MIN_SIMILARITY=0.51
# NO_EVIDENCE_MIN_TS_RANK=0.02

# ── 诊断接口（默认关闭）────────────────────────────────────────
# /debug/* 直查库表，仅供标定阈值、排查范围隔离等运维场景临时开启。
# DEBUG_ENDPOINTS=1
